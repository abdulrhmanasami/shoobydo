FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY apps/backend/requirements.txt /app/requirements.txt
RUN pip install --upgrade pip wheel && pip install -r /app/requirements.txt \
    && pip install --no-cache-dir alembic psycopg2-binary

# Copy application code
COPY apps/backend/app /app/app
COPY apps/backend/alembic /app/alembic
COPY apps/backend/alembic.ini /app/alembic.ini

# Create non-root user
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=10 \
    CMD curl -fsS http://localhost:8001/health || exit 1

# Run the application
ENV PORT=8001
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
